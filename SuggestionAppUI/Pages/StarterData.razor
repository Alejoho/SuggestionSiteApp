@page "/StarterData"
@using Microsoft.Extensions.Caching.Memory
@inject ICategoryData CategoryData
@inject IStatusData StatusData
@inject ISuggestionData SuggestionData
@inject IUserData UserData
@inject IMemoryCache Cache;
<h3>Starter Data</h3>

@if (_areThereCategories)
{
    <p>Categories already initialized</p>
}
else
{
    <buttton class="btn btn-primary mx-2" @onclick="CreateCategories">Create Categories</buttton>
}

@if (_areThereStatuses)
{
    <p>Statuses already initialized</p>
}
else
{
    <button class="btn btn-primary mx-2" @onclick="CreateStatuses">Create Statuses</button>
}

@if (_areThereSuggestions)
{
    <p>Suggestions already initialized</p>
}
else
{
    <button class="btn btn-primary mx-2"
            disabled="@IsSuggestionBtnEnable"
            @onclick="CreateSuggestions">
        Create Suggestions
    </button>
}



@code {
    private bool _areThereCategories = false;
    private bool _areThereStatuses = false;
    private bool _areThereSuggestions = false;
    private bool IsSuggestionBtnEnable { get => _areThereCategories == false || _areThereStatuses == false; }

    protected override async Task OnInitializedAsync()
    {
        Cache.Remove("CategoryData");
        Cache.Remove("StatusData");
        var categories = await CategoryData.GetAllCategoriesAsync();
        _areThereCategories = categories.Count > 0 ? true : false;

        var statuses = await StatusData.GetAllStatusesAsync();
        _areThereStatuses = statuses.Count > 0 ? true : false;

        var suggestions = await SuggestionData.GetAllSuggestions();
        _areThereSuggestions = suggestions.Count > 0 ? true : false;
    }

    private async Task CreateCategories()
    {
        CategoryModel category = new()
        {
            CategoryName = "Courses",
            CategoryDescription = "Full paid courses."
        };

        await CategoryData.CreateCategory(category);

        category = new()
        {
            CategoryName = "Dev Questions",
            CategoryDescription = "Advice on being a developer."
        };

        await CategoryData.CreateCategory(category);

        category = new()
        {
            CategoryName = "In-Depth Tutorial",
            CategoryDescription = "A deep-dive video on how to use a topic."
        };

        await CategoryData.CreateCategory(category);

        category = new()
        {
            CategoryName = "10-Minute Training",
            CategoryDescription = "A quick \"How do I use this?\" video."
        };

        await CategoryData.CreateCategory(category);

        category = new()
        {
            CategoryName = "Other",
            CategoryDescription = "Not sure which category this fits in."
        };

        await CategoryData.CreateCategory(category);

        _areThereCategories = true;
    }

    private async Task CreateStatuses()
    {
        StatusModel status = new()
        {
            StatusName = "Completed",
            StatusDescription = "The suggestion was acceted and the corresponding item was created."
        };

        await StatusData.CreateStatus(status);

        status = new()
        {
            StatusName = "Watching",
            StatusDescription = "The suggestion is interesting. We are watching to see how much interest there is in it."
        };
        await StatusData.CreateStatus(status);

        status = new()
        {
            StatusName = "Upcoming",
            StatusDescription = "The suggestion was accepted and it will be released soon."
        };
        await StatusData.CreateStatus(status);

        status = new()
        {
            StatusName = "Dismissed",
            StatusDescription = "The suggestion was not something that we are going to undertake."
        };
        await StatusData.CreateStatus(status);

        _areThereStatuses = true;
    }

    private async Task CreateSuggestions()
    {
        // create the user
        UserModel newUser = new()
        {
            FirstName = "Alejo",
            LastName = "Hdez",
            EmailAddress = "alejo@hdez.cu",
            DisplayName = "Sample Alejo",
            ObjectIdentifier = "123-abc"
        };

        await UserData.CreateUser(newUser);
        // then insert 5 suggestions for that user

        var foundUser = await UserData.GetUserByObjectId("123-abc");

        HashSet<string> votes = new() { "1", "2", "3", "4", "5" };
        var categories = await CategoryData.GetAllCategoriesAsync();
        var statuses = await StatusData.GetAllStatusesAsync();

        SuggestionModel suggestion = new()
        {
            Author = new BasicUserModel(foundUser),
            Category = categories[0],
            Suggestion = "Our First Suggestion",
            Description = "This is a suggestion created by the sample data generation method.",
            SuggestionStatus = statuses[0],
            ApprovedForRelease = true
        };
        await SuggestionData.CreateSuggestion(suggestion);

        suggestion = new()
        {
            Author = new BasicUserModel(foundUser),
            Category = categories[1],
            Suggestion = "Our Second Suggestion",
            Description = "This is a suggestion created by the sample data generation method.",
            SuggestionStatus = statuses[0],
            OwnerNotes = "This is the note for the status.",
            ApprovedForRelease = true
        };
        await SuggestionData.CreateSuggestion(suggestion);

        suggestion = new()
        {
            Author = new BasicUserModel(foundUser),
            Category = categories[2],
            Suggestion = "Our Third Suggestion",
            Description = "This is a suggestion created by the sample data generation method.",
            SuggestionStatus = statuses[1],
            OwnerNotes = "This is the note for the status.",
            ApprovedForRelease = true
        };
        await SuggestionData.CreateSuggestion(suggestion);

        suggestion = new()
        {
            Author = new BasicUserModel(foundUser),
            Category = categories[3],
            Suggestion = "Our Fourth Suggestion",
            Description = "This is a suggestion created by the sample data generation method.",
            SuggestionStatus = statuses[2],
            UserVotes = votes,
            OwnerNotes = "This is the note for the status.",
            ApprovedForRelease = true
        };
        await SuggestionData.CreateSuggestion(suggestion);

        votes.Remove("3");
        votes.Remove("4");

        suggestion = new()
        {
            Author = new BasicUserModel(foundUser),
            Category = categories[4],
            Suggestion = "Our Fifth Suggestion",
            Description = "This is a suggestion created by the sample data generation method.",
            SuggestionStatus = statuses[3],
            UserVotes = votes,
            OwnerNotes = "This is the note for the status.",
            ApprovedForRelease = true
        };
        await SuggestionData.CreateSuggestion(suggestion);

        _areThereSuggestions = true;
    }
}
